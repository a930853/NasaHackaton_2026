; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NasaSimuladorMision"
run/main_scene="uid://bj3rdjmiiuuhb"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://c1bntj6aapk3m"

[autoload]

Events="*uid://chtahno0wqyim"
GameState="*res://Scripts/game_state.gd"
GlossaryManager="*res://Scripts/glossary_manager.gd"
EventManager="*res://Scripts/event_manager.gd"
TurnManager="*res://Scripts/turn_manager.gd"
Net="*res://Scripts/net.gd"
PhoneBridge="*res://Scripts/phone_bridge.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
mouse_cursor/custom_image="uid://pj6wvscla1rp"
mouse_cursor/custom_image_hotspot=Vector2(18, 5)

[file_customization]

folder_colors={
"res://Images/": "blue",
"res://Scenes/": "red",
"res://Scripts/": "green",
"res://Sound/": "purple"
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
